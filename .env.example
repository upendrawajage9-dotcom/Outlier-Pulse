# =============================================================================
# OutlierPulse — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# All integrations support graceful sandbox / mock fallbacks if keys are omitted.
# =============================================================================

# YouTube Data API v3 (Optional: enables live channel analytics & quota-optimized fetching)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API (Optional: powers AI psychological viral hook breakdown & title generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis (Optional: enables sub-20ms edge caching for channel intelligence queries)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
